# 이 파일을 복사해서 .env로 만들고 실제 값을 채워주세요.
# cp .env.example .env
# .env는 .gitignore에 반드시 포함되어야 합니다 (커밋 금지).

# ── Backend API ─────────────────────────────
VITE_API_BASE_URL=http://localhost:8080
VITE_WS_BASE_URL=ws://localhost:8000

# ── 음성 (STT/TTS) ───────────────────────────
# 프론트에서 직접 STT/TTS를 호출하는 경우에만 필요.
# 보안상 가능하면 백엔드를 경유하는 걸 권장.
VITE_STT_TTS_API_KEY=
